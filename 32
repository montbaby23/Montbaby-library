<!doctype html>
<html lang="ms">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
  <meta name="theme-color" content="#f6efe3" />
  <meta name="description" content="Montbaby Library — perpustakaan digital buku kanak-kanak Montbaby." />
  <link rel="manifest" href="manifest.webmanifest" />
  <link rel="icon" href="assets/brand/logo.png" />
  <link rel="stylesheet" href="style.css" />
  <title>Montbaby Library</title>
</head>
<body>
  <header class="topbar">
    <button class="brand" onclick="showHome()" aria-label="Montbaby Library home">
      <img src="assets/brand/logo.png" alt="Montbaby" />
      <span>Library</span>
    </button>
    <button id="installBtn" class="install-btn" hidden>Pasang</button>
  </header>

  <main id="homeView">
    <section class="hero">
      <p class="eyebrow">DIGITAL STORYBOOK LIBRARY</p>
      <h1>Baca, teroka & belajar bersama Montbaby.</h1>
      <p class="hero-copy">Siri 5 Deria boleh diterokai secara percuma. Koleksi premium akan dibuka selepas pembelian.</p>
      <div class="hero-actions">
        <button class="primary" onclick="openBook('mata')">Baca Mata Saya</button>
        <a class="secondary" href="#library">Lihat Library</a>
      </div>
    </section>

    <section id="library" class="section">
      <div class="section-head">
        <div>
          <p class="eyebrow">PERCUMA</p>
          <h2>Siri 5 Deria Ciptaan Allah</h2>
        </div>
        <span class="pill">5 buku</span>
      </div>
      <div class="book-grid">
        <article class="book-card ready" onclick="openBook('mata')" tabindex="0">
          <div class="cover-wrap"><img src="assets/covers/mata.jpg" alt="Mata Haura" /><span class="badge free">FREE</span></div>
          <h3>Mata Saya</h3><p>Boleh dibaca sekarang</p><button>Baca sekarang →</button>
        </article>
        <article class="book-card" onclick="notUploaded('Telinga Saya')" tabindex="0">
          <div class="cover-wrap"><img src="assets/covers/telinga.jpg" alt="Telinga Haura" /><span class="badge free">FREE</span></div>
          <h3>Telinga Saya</h3><p>Halaman penuh akan dimuat naik</p><button>Segera</button>
        </article>
        <article class="book-card" onclick="notUploaded('Hidung Saya')" tabindex="0">
          <div class="cover-wrap"><img src="assets/covers/hidung.jpg" alt="Hidung Haura" /><span class="badge free">FREE</span></div>
          <h3>Hidung Saya</h3><p>Halaman penuh akan dimuat naik</p><button>Segera</button>
        </article>
        <article class="book-card" onclick="notUploaded('Kulit Saya')" tabindex="0">
          <div class="cover-wrap"><img src="assets/covers/kulit.jpg" alt="Kulit Haura" /><span class="badge free">FREE</span></div>
          <h3>Kulit Saya</h3><p>Halaman penuh akan dimuat naik</p><button>Segera</button>
        </article>
        <article class="book-card" onclick="notUploaded('Lidah Saya')" tabindex="0">
          <div class="cover-wrap"><img src="assets/covers/lidah.jpg" alt="Lidah Haura" /><span class="badge free">FREE</span></div>
          <h3>Lidah Saya</h3><p>Halaman penuh akan dimuat naik</p><button>Segera</button>
        </article>
      </div>
    </section>

    <section class="section premium-section">
      <div class="section-head">
        <div><p class="eyebrow">PREMIUM</p><h2>Koleksi Montbaby Lain</h2></div>
        <span class="pill dark">🔒 Premium</span>
      </div>
      <div class="premium-grid">
        <button class="premium-card" onclick="showPremium('Siri Emosi')"><span>♡</span><strong>Siri Emosi</strong><small>Unlock selepas pembelian</small></button>
        <button class="premium-card" onclick="showPremium('Siri Anak Soleh')"><span>☾</span><strong>Siri Anak Soleh</strong><small>Unlock selepas pembelian</small></button>
        <button class="premium-card" onclick="showPremium('Siri Merdeka')"><span>★</span><strong>Siri Merdeka</strong><small>Unlock selepas pembelian</small></button>
      </div>
    </section>
  </main>

  <section id="readerView" class="reader-view" hidden>
    <div class="reader-toolbar">
      <button class="icon-btn" onclick="closeReader()">← Library</button>
      <div><strong>Mata Saya</strong><span id="pageCounter">1 / 8</span></div>
      <button class="icon-btn" onclick="toggleFullscreen()">⛶</button>
    </div>

    <div class="reader-stage" id="readerStage">
      <button class="nav-arrow left" onclick="prevPage()" aria-label="Halaman sebelumnya">‹</button>
      <div class="book-frame" id="bookFrame">
        <img id="pageImage" src="assets/books/mata/01-cover.png" alt="Halaman buku Mata Saya" draggable="false" />
      </div>
      <button class="nav-arrow right" onclick="nextPage()" aria-label="Halaman seterusnya">›</button>
    </div>

    <div class="reader-bottom">
      <input id="pageSlider" type="range" min="1" max="8" value="1" aria-label="Pilih halaman" />
      <p>Swipe kiri/kanan atau gunakan anak panah.</p>
    </div>
  </section>

  <div id="modal" class="modal" hidden>
    <div class="modal-card">
      <button class="close-x" onclick="closeModal()">×</button>
      <div id="modalIcon" class="modal-icon">♡</div>
      <h3 id="modalTitle">Montbaby</h3>
      <p id="modalText"></p>
      <button class="primary wide" onclick="closeModal()">Baik</button>
    </div>
  </div>

  <footer>
    <img src="assets/brand/logo.png" alt="Montbaby" />
    <p>© Montbaby · Digital Library</p>
  </footer>

  <script src="app.js"></script>
</body>
</html>
